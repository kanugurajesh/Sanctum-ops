# LLM provider: groq (default) or gemini
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini, only if LLM_PROVIDER=gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Change for anything beyond a local demo
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
