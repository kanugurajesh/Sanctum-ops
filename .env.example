# LLM provider: groq (default) or qwen (optional local model)
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional local fine-tuned Qwen served by Ollama, only if LLM_PROVIDER=qwen.
# No API key; build the model first with training/README.md.
# QWEN_BASE_URL=http://host.docker.internal:11434/v1
# QWEN_MODEL=hms-intent-qwen

# Change for anything beyond a local demo
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
